# ─────────────────────────────────────────────────────────────
#  Переменные окружения / Environment variables
#  Скопируйте этот файл в .env и подставьте свои значения.
#  Copy this file to .env and fill in real values.
# ─────────────────────────────────────────────────────────────

# Публичный адрес сайта / Public site URL
# Используется на сервере: canonical, Open Graph, sitemap, robots, вебхук.
# Префикс NEXT_PUBLIC_ не нужен — значение не должно попадать в браузер.
SITE_URL=https://romka.agacher.com

# ── База данных (PostgreSQL) ─────────────────────────────────
# Vercel Postgres / Neon / Supabase. Если переменная не задана,
# сайт работает на локальном JSON-хранилище (.data/leads.json) —
# только для разработки, на Vercel так нельзя.
DATABASE_URL=postgresql://user:password@host:5432/romka?sslmode=require

# ── Telegram-бот ─────────────────────────────────────────────
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# ID чата менеджера (или несколько через запятую)
TELEGRAM_CHAT_ID=
# Секрет для проверки вебхука (любая строка, передаётся в setWebhook secret_token)
TELEGRAM_WEBHOOK_SECRET=

# ── CRM / админ-панель ───────────────────────────────────────
# Секрет для подписи JWT-сессии (минимум 32 символа)
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Учётные данные администраторов (email:пароль, несколько — через «;»)
ADMIN_CREDENTIALS=admin@example.com:change-me-please

# ── Яндекс.Метрика ───────────────────────────────────────────
# Только номер счётчика, например 12345678. Пусто — метрика не грузится.
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# ── Прочее ───────────────────────────────────────────────────
# Каталог локального JSON-хранилища (разработка без PostgreSQL)
LOCAL_DATA_DIR=.data
